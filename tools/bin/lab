#!/usr/bin/env bash
# Lab control helper for the MinIO vs Silo evaluation.
#
# Every Compose project is driven from here so that start/stop order is applied
# consistently. Never run more than one heavy stack at a time — the single
# exception is `rep-target`, which DEV-909 requires and which this script
# enforces separately below.
#
# Every destructive command must name the product it targets, so "down" can
# never be ambiguous about which stack it hits.
#
# Usage:
#   lab network            create the shared migration-net (idempotent)
#   lab up minio           start the 4-node MinIO cluster, wait until healthy
#   lab up silo            start the 4-node Silo cluster, wait until healthy
#   lab up proxy           start the load balancers
#   lab up workload        start the long-lived client containers
#   lab up monitoring      start the metrics scraper (publishes no ports)
#   lab up rep-target      start the SECOND MinIO deployment used as the
#                          replication target (DEV-909 only)
#   lab down minio|silo|proxy|workload|monitoring|rep-target
#   lab wipe minio|silo    destroy one product's data directory, then recreate
#                          the empty node dirs. Refuses while that cluster runs.
#   lab restart-workload   recreate client containers so bind mounts refresh
#   lab status             show what is running
#   lab ps <product>       compose ps for one project

set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
COMPOSE="$ROOT/lab/compose"
ENV_FILE="$COMPOSE/.env"

# Pin by digest, taken from the image the cluster node images are built FROM, so
# `wipe` never depends on a floating tag resolving. ubi-micro is 32 MB and
# already pulled, so this adds no meaningful disk cost.
UBI_MICRO="registry.access.redhat.com/ubi9/ubi-micro@sha256:932aec77f5b86a5dba854a18b14a38725b296967e7dc9c7a1f4d7f0bf82e1ce5"

die() { printf 'lab: %s\n' "$*" >&2; exit 1; }
say() { printf '\n== %s ==\n' "$*"; }

[ -f "$ENV_FILE" ] || die "missing $ENV_FILE (copy .env.example and set credentials)"

# Product name -> compose project directory.
project_for() {
  case "$1" in
    minio)     echo minio ;;
    silo)      echo silo ;;
    proxy)     echo proxy ;;
    workload)  echo workload ;;
    monitoring) echo monitoring ;;
    rep-target) echo replication-target ;;
    restart-workload) echo workload ;;
    *)         die "unknown target '$1' (expected minio|silo|proxy|workload|monitoring|rep-target|restart-workload)" ;;
  esac
}

dc() {
  local dir="$1"; shift
  ( cd "$COMPOSE/$dir" && docker compose --env-file "$ENV_FILE" "$@" )
}

wait_healthy() {
  # $1 = compose project name, $2 = timeout. The project name is passed in
  # rather than derived from the directory, because minio-cluster and
  # silo-cluster do not follow the "<dir>-cluster" shape uniformly.
  local project="$1" timeout="${2:-180}" waited=0 running
  say "waiting for $project to become healthy (timeout ${timeout}s)"
  while [ "$waited" -lt "$timeout" ]; do
    local total unhealthy
    total="$(docker ps --filter "label=com.docker.compose.project=$project" -q | wc -l)"
    unhealthy="$(docker ps --filter "label=com.docker.compose.project=$project" \
                  --filter health=unhealthy -q | wc -l)"
    if [ "$total" -gt 0 ] && [ "$unhealthy" -eq 0 ]; then
      running="$(docker ps --filter "label=com.docker.compose.project=$project" \
                  --filter status=running -q | wc -l)"
      if [ "$running" -eq "$total" ]; then
        echo "  $project: $running/$total running, 0 unhealthy"
        return 0
      fi
    fi
    sleep 5
    waited=$((waited + 5))
    printf '  ... %ss\n' "$waited"
  done
  printf '  TIMEOUT waiting for %s\n' "$project" >&2
  return 1
}

case "${1:-}" in
  network)
    if docker network inspect migration-net >/dev/null 2>&1; then
      echo "migration-net already exists"
    else
      docker network create migration-net >/dev/null
      echo "created migration-net"
    fi
    ;;

  up)
    target="${2:-}"; [ -n "$target" ] || die "usage: lab up <minio|silo|proxy|workload|monitoring|rep-target>"
    dir="$(project_for "$target")"

    # nginx resolves its upstream names while loading the config and exits with
    # "host not found in upstream" if any backend is missing. A load balancer
    # for a cluster that is not running would therefore crash-loop, so start
    # only the balancers whose backend cluster is actually up.
    if [ "$target" = "proxy" ]; then
      services=()
      docker ps --format '{{.Names}}' | grep -qx 'minio-1' && services+=(lb-minio)
      docker ps --format '{{.Names}}' | grep -qx 'silo-1'  && services+=(lb-silo)
      if [ "${#services[@]}" -eq 0 ]; then
        die "no cluster is running; start a cluster before the proxy"
      fi
      say "starting ${services[*]}"
      dc "$dir" up -d "${services[@]}"
      dc "$dir" ps
      exit 0
    fi

    # DEV-909 needs the replication source and target resident together. That
    # exception is deliberately narrow and is enforced here rather than trusted to
    # whoever runs the phase: the target may only come up alongside the MinIO
    # source. Allowing it against the Silo cluster would create a two-product
    # co-resident lab, which is the configuration that makes a comparison
    # meaningless and that check-no-mixed-cluster exists to prevent.
    if [ "$target" = "rep-target" ] && docker ps --format '{{.Names}}' | grep -qx 'silo-1'; then
      die "silo is running; 'lab down silo' first — the replication target may only run alongside the MinIO source"
    fi

    dc "$dir" up -d
    case "$target" in
      minio)     wait_healthy minio-cluster ;;
      silo)      wait_healthy silo-cluster ;;
      rep-target) wait_healthy minio-replication-target ;;
      monitoring) wait_healthy monitoring 120 ;;
      storage)   sleep 3; dc "$dir" ps ;;
      *) sleep 3; dc "$dir" ps ;;
    esac
    ;;

  down)
    target="${2:-}"; [ -n "$target" ] || die "usage: lab down <minio|silo|proxy|workload|monitoring|rep-target>"
    dir="$(project_for "$target")"
    # Never remove data volumes. Cluster data lives in bind mounts under
    # lab/data, which Compose never owns, so no -v is ever passed.
    dc "$dir" down --remove-orphans
    ;;

  wipe)
    target="${2:-}"
    case "$target" in
      minio) PRODUCT=minio;  PROJECT=minio-cluster ;;
      silo)  PRODUCT=silo;   PROJECT=silo-cluster ;;
      rep-target) PRODUCT=minio-rep; PROJECT=minio-replication-target ;;
      *) die "usage: lab wipe <minio|silo|rep-target>" ;;
    esac
    DATA="$ROOT/lab/data/$PRODUCT"
    PARENT="$(dirname "$DATA")"

    # Wiping under a live cluster would silently reformat on restart and lose
    # the very evidence the wipe was meant to clear, so this refuses outright.
    if [ -n "$(docker ps --filter "label=com.docker.compose.project=$PROJECT" -q)" ]; then
      die "$PRODUCT cluster is running; 'lab down $PRODUCT' first"
    fi

say "wiping $DATA"
    # The servers run as root and leave root-owned files inside the bind mount,
    # and sudo needs interactive auth on this host (D-010). Deleting through a
    # root container avoids both, needs no extra image (ubi-micro is 32 MB and
    # already pulled), and --network none keeps it off the network entirely.
    #
    # The mount is on the PARENT directory, not on $DATA itself: that removes
    # $DATA outright and it is then recreated below by the devops user, so the
    # result is owned correctly instead of staying root-owned from the previous
    # run.
    docker run --rm --network none -v "$PARENT":/parent \
      "$UBI_MICRO" \
      sh -c "rm -rf '/parent/$(basename "$DATA")'"
    for n in 1 2 3 4; do mkdir -p "$DATA/node-$n"; done
    echo "  $DATA removed and recreated empty; node-1..4 owned by $(id -un)"
    ;;

  # Recreate the client containers so their bind mounts point at the current
  # inode of the dataset directory.
  #
  # This is needed because gen-dataset and `lab wipe` delete and recreate
  # lab/data/dataset and lab/data/<product>. A bind mount resolves to the inode
  # that existed at mount time, so a container started earlier keeps serving the
  # OLD directory after a delete-and-recreate: /dataset looks empty even though
  # the host directory is full, and seeding "succeeds" with zero objects. That
  # silent-empty-mount trap is worse than a visible error, so the fix lives here
  # rather than as a habit of remembering to restart.
  restart-workload)
    say "recreating workload containers to refresh their bind mounts"
    dc workload down --remove-orphans
    dc workload up -d
    sleep 3
    dc workload ps
    # Prove the refresh worked instead of assuming it.
    for c in mc-client silo-client; do
      printf '  %-13s sees %s dataset entries\n' "$c" \
        "$(docker exec "$c" ls /dataset 2>/dev/null | wc -l)"
    done
    ;;

  status)
    say "compose projects"
    for dir in minio silo replication-target proxy workload monitoring storage; do
      printf '%s:\n' "$dir"
      dc "$dir" ps --format '  {{.Name}}\t{{.Status}}' 2>/dev/null || echo "  (not created)"
    done
    ;;

  ps)
    target="${2:-}"; [ -n "$target" ] || die "usage: lab ps <minio|silo|proxy|workload|monitoring|rep-target>"
    dc "$(project_for "$target")" ps
    ;;

  *)
    sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac