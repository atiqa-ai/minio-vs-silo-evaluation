#!/usr/bin/env bash
# Reject any Compose project or nginx upstream block that mixes MinIO and Silo
# nodes.
#
# G4: every cluster must be a single product at a single version. A
# file that references both minio-* and silo-* hostnames would produce a hybrid
# cluster whose results are meaningless, and would also invalidate the
# comparable-environment rule (G6).
#
# The MinIO and Silo cluster files live in separate directories, and the proxy
# file may reference both because it balances to two separate upstream pools that
# are never combined into one cluster.
#
# Comments are stripped before matching. The Silo compose file documents its
# differences from the MinIO file in a comment that necessarily mentions
# "minio-1..4"; prose about the other product is not a cluster reference.

set -uo pipefail
cd "$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "not a git repo" >&2; exit 1; }

status=0

# Emits node references found in non-comment content only.
nodes_in() {
  grep -v '^[[:space:]]*#' "$1" | grep -oE '\b(minio|silo)-[1-9][0-9]*\b' || true
}

check_file() {
  local f="$1"
  [ -f "$f" ] || return 0
  local refs m s
  refs="$(nodes_in "$f")"
  m="$(printf '%s\n' "$refs" | grep -c '^minio-' || true)"
  s="$(printf '%s\n' "$refs" | grep -c '^silo-'  || true)"
  printf '  %-42s %s minio, %s silo\n' "$f" "$m" "$s"
  if [ "$m" -gt 0 ] && [ "$s" -gt 0 ]; then
    echo "    FAILED: one cluster file must reference a single product"
    status=1
  fi
}

echo "check-no-mixed-cluster:"
# Discovered, not hardcoded. A cluster project added later must not be able to
# escape this check by simply not being listed here -- which is exactly what
# happened with replication-target, the DEV-909 target deployment.
for f in lab/compose/*/compose.yml lab/compose/proxy/nginx-*.conf; do
  check_file "$f"
done

if [ "$status" -eq 0 ]; then
  echo "  OK: no cluster mixes products"
fi
exit "$status"