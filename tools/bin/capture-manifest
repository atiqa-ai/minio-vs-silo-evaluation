#!/usr/bin/env bash
# capture-manifest - read a seeded bucket back from the server and emit one JSON
# object per key with all seven fields the ST02 manifest must carry.
#
# G11: the same script and the same client binary
# run against MinIO and against Silo, so the only variable between the two runs
# is the storage backend. Nothing here interprets the result; comparison is
# verify-manifest's job.
#
# Two of the seven fields cannot come from the local generator:
#
#   Version ID  server-assigned. Absent locally, so it is read back from the
#               server. TC-ST02-02 fails if any object has an empty Version ID.
#   Checksum    the generator records both SHA-256 and MD5, but the server
#               reports only the S3 ETag, which for these objects is the MD5.
#               ETag is captured as-is and compared against the local MD5, so a
#               non-MD5 ETag (multipart or encrypted) surfaces as a mismatch
#               rather than being quietly accepted.
#
# Division of labour, forced by what the client images actually contain:
#
#   in-container  the mc calls, and only bash parameter expansion. mc-client has
#                 no sed, awk, grep, python, perl or jq (verified), so any
#                 text processing in there would be impossible.
#   on-host       all parsing and JSON assembly, with python3.
#
# `mc ls --recursive --json` is deliberately NOT used for enumeration: it emits
# size/etag/key but no versionId, so every object would need a second call
# anyway. Keys come from plain `mc ls --recursive` and each key then gets one
# `mc stat --json` (key, size, etag, versionId, metadata, retention) plus one
# `mc tag list` (tags, which stat omits).
#
# Usage: tools/bin/capture-manifest <minio|silo|rep> <bucket>
#
# Writes JSON Lines to stdout so it can be redirected straight into evidence/.

set -euo pipefail

PRODUCT="${1:-}"
BUCKET="${2:-}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

case "$PRODUCT" in
  minio) CLIENT=mc-client ;;
  silo)  CLIENT=silo-client ;;
  # The DEV-909 replication target is itself MinIO, so it is driven by the same
  # mc client over the same network. Only the alias differs, and the alias
  # resolution check below is what proves the right deployment is being read:
  # a typo'd or unconfigured 'rep' alias aborts instead of quietly reporting an
  # empty bucket.
  rep)   CLIENT=mc-client ;;
  *) echo "usage: $0 <minio|silo|rep> <bucket>" >&2; exit 2 ;;
esac
[ -n "$BUCKET" ] || { echo "usage: $0 <minio|silo|rep> <bucket>" >&2; exit 2; }

# Same guard as seed-dataset: refuse to run against an alias that does not
# resolve to a network endpoint, because mc would silently fall back to a
# filesystem client and "capture" local files instead of the bucket.
endpoint=""
for line in $(docker exec "$CLIENT" mc alias list "$PRODUCT" 2>/dev/null); do
  case "$line" in
    *http://*|*https://*) endpoint="$line"; break ;;
  esac
done
if [ -z "$endpoint" ]; then
  echo "ABORT: alias '$PRODUCT' does not resolve to an http(s) endpoint in $CLIENT." >&2
  exit 1
fi
ALIAS="$PRODUCT/$BUCKET"

# Raw capture: three tab-separated fields per object, values still JSON-encoded
# or comma-separated exactly as mc printed them. Nothing is interpreted here.
RAW=$(mktemp)
trap 'rm -f "$RAW"' EXIT

# Everything happens inside the container: enumeration included. A host temp file
# cannot be handed over as a path, because /tmp inside the container is a
# different filesystem from /tmp on the host.
#
# Concurrency matches seed-dataset's default. Each object costs two mc round
# trips, so this is the same shape of load the seeding already applied.
docker exec -i "$CLIENT" bash -s -- "$ALIAS" > "$RAW" <<'INNER'
set -uo pipefail
ALIAS="$1"
CONCURRENCY="${CAPTURE_CONCURRENCY:-4}"

capture_one() {
  local key="$1" stat tags
  # stat is one compact line on this mc build; the value is passed through
  # verbatim so the host can parse it as JSON rather than trusting a regex.
  stat=$(mc stat --json "$ALIAS/$key" 2>/dev/null)
  # `mc tag list` prints a header line, then one "key : value" per tag, or the
  # bare sentence "No tags found" when there are none. Two things must happen
  # HERE, while the output is still newline-separated:
  #   - drop the header and the no-tag notice, because once the lines are
  #     comma-joined for transport the whole string's first field is "Name",
  #     and a host-side filter would then discard every real tag;
  #   - rewrite "key : value" as "key=value", which is the form the local
  #     manifest uses, so the comparison is not a guaranteed mismatch.
  # The header's padding is not fixed ("Name    :" vs "Name :"), so the field is
  # compared after trimming rather than by exact match.
  tags=$(mc tag list "$ALIAS/$key" 2>/dev/null | while IFS= read -r line; do
    case "$line" in
      *:*) ;;
      *) continue ;;
    esac
    field="${line%%:*}"
    rest="${line#*:}"
    field="${field#"${field%%[![:space:]]*}"}"; field="${field%"${field##*[![:space:]]}"}"
    rest="${rest#"${rest%%[![:space:]]*}"}";   rest="${rest%"${rest##*[![:space:]]}"}"
    case "${field,,}" in
      name) continue ;;
    esac
    printf '%s=%s\n' "$field" "$rest"
  done)
  # Newlines would break the line-oriented protocol. Both fields are single-line
  # on this mc build, but flatten defensively rather than emit a corrupt record.
  printf '%s\t%s\t%s\n' "$key" "${stat//$'\n'/}" "${tags//$'\n'/,}"
}

# Enumerate here too. `mc ls --recursive` prints
# "[<timestamp>]<spaces><size> <type> <key>", e.g.
#   [2026-10-01 22:42:53 UTC]     0B STANDARD empty/00000.bin
#   [2026-10-01 22:44:59 UTC] 3.9KiB STANDARD special/chars with spaces+plus/00000.bin
#
# Two traps, both of which were hit and fixed rather than reasoned about in
# advance:
#
#   * ${line##* } (everything after the LAST space) is wrong, and silently
#     corrupts data. Any key containing a space loses its prefix, so the 25
#     objects under "special/chars with spaces+plus/" were enumerated as
#     "spaces+plus/..." and reported as 25 missing plus 25 extra while the
#     objects themselves were intact.
#   * The size field is RIGHT-ALIGNED in its column, so several spaces separate
#     "]" from the size. Stripping only one of them leaves leading blanks, and a
#     later single-token strip then removes the size instead of the type,
#     leaving "0B STANDARD empty/00000.bin" as the key.
#
# So: cut at the first "]", drop leading blanks, then drop the size token and
# the type token as separate fields. Key-internal spaces are never touched.
# No backslash escapes are used, because an escaped "]" inside a case pattern or
# a ${var#...} pattern is easy for a shell layer to mangle, and a guard that
# quietly stops matching would drop every key and yield an empty capture.
KEYS=$(mktemp)
mc ls --recursive "$ALIAS" 2>/dev/null | while IFS= read -r line; do
  case "$line" in
    "["*"] "*) ;;
    *) continue ;;
  esac
  key="${line#*]}"
  key="${key#"${key%%[![:space:]]*}"}"
  key="${key#* }"
  case "$key" in
    "STANDARD "*|"file "*|"directory "*) key="${key#* }" ;;
  esac
  [ -n "$key" ] && printf '%s\n' "$key"
done > "$KEYS"

TOTAL=$(wc -l < "$KEYS")
[ "$TOTAL" -gt 0 ] || { echo "ABORT: no objects found in $ALIAS" >&2; rm -f "$KEYS"; exit 1; }
echo "== $ALIAS: $TOTAL objects to capture" >&2

while IFS= read -r key; do
  [ -n "$key" ] || continue
  capture_one "$key" < /dev/null &
  while [ "$(jobs -r | wc -l)" -ge "$CONCURRENCY" ]; do wait -n || true; done
done < "$KEYS"
wait
rm -f "$KEYS"
INNER

total=$(wc -l < "$RAW")
if [ "$total" -eq 0 ]; then
  echo "ABORT: captured 0 records from $ALIAS" >&2
  exit 1
fi
echo "== captured $total records" >&2

# Host-side assembly, where python3 exists.
python3 - "$PRODUCT" "$BUCKET" "$RAW" <<'PY'
import json, sys

product, bucket, raw_path = sys.argv[1], sys.argv[2], sys.argv[3]
out = []
unparsed_stat = []

with open(raw_path, encoding="utf-8") as fh:
    for n, line in enumerate(fh, 1):
        line = line.rstrip("\n")
        if not line:
            continue
        parts = line.split("\t")
        if len(parts) != 3:
            unparsed_stat.append((parts[0] if parts else f"line{n}", "malformed record"))
            continue
        key, stat_raw, tags_raw = parts
        try:
            stat = json.loads(stat_raw)
        except (json.JSONDecodeError, TypeError):
            unparsed_stat.append((key, "stat not valid JSON"))
            continue

        meta = stat.get("metadata") or {}

        def m(name):
            for k, v in meta.items():
                if k.lower() == name.lower():
                    return v if v is not None else ""
            return ""

        row = {
            "key": key,
            "size": str(stat.get("size", "")),
            "etag": (stat.get("etag") or "").strip('"'),
            # This mc build spells the key `versionID` (capital ID), not the
            # `versionId` used by the S3 API and by newer mc builds. Accept
            # either spelling, or every object silently reads as having no
            # Version ID and TC-ST02-02 fails for the wrong reason.
            "versionId": stat.get("versionID") or stat.get("versionId") or "",
            "lastModified": stat.get("lastModified") or "",
            # Header already stripped in-container, so the value here is
            # "k=v,k=v" with no newline structure left to mis-parse.
            "tags": ",".join(t.strip() for t in tags_raw.split(",") if t.strip()),
            # Drop the headers that are not user metadata, or every object
            # would show a spurious diff against the local manifest.
            "metadata": ",".join(
                "%s=%s" % (k[len("X-Amz-Meta-"):], v)
                for k, v in sorted(meta.items())
                if k.lower().startswith("x-amz-meta-")
            ),
            "retentionMode": m("X-Amz-Object-Lock-Mode"),
            "retentionUntil": m("X-Amz-Object-Lock-Retain-Until-Date"),
        }
        out.append(row)

for key, why in unparsed_stat:
    sys.stderr.write("WARN %s/%s: %s\n" % (product, bucket, why))

# Deterministic order so two captures of the same bucket diff cleanly.
out.sort(key=lambda r: r["key"])
for row in out:
    print(json.dumps(row, sort_keys=True))

sys.stderr.write("CAPTURE_SUMMARY\tproduct=%s\tbucket=%s\tcaptured=%d\n"
                 % (product, bucket, len(out)))
PY