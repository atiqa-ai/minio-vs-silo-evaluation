# Shared lab configuration — MinIO vs Silo evaluation.
#
# Copy to .env and fill in lab values. .env is gitignored because it carries
# credentials. This file carries no real secrets.
#
# Resource limits below are applied IDENTICALLY to the MinIO and Silo clusters.
# That is a hard requirement of the comparable-environment rule: if the
# two products get different CPU, memory, volume types, data or repetition
# counts, the ST08 comparison is invalid.

# ---------------------------------------------------------------- test profile
# This host is below the 8 vCPU / 32 GiB reference host. All benchmark figures
# are therefore labelled INDICATIVE ONLY. Recorded as a deviation in
# ../../DEVIATIONS.md
PROFILE_LABEL=indicative-only
HOST_CPU_CORES=4
HOST_RAM_GIB=7.7
HOST_DISK_FREE_GB=21

# ---------------------------------------------------- per-node resource limits
# Identical for MinIO and Silo nodes.
NODE_CPUS=0.80
NODE_MEM=900m

# ------------------------------------------------------------- cluster sizing
# 4 nodes x 1 drive + load-balancer container, per Profile B topology.
# Reduced from Profile B only in dataset size; node/drive counts are as specified.
NODES=4
DRIVES_PER_NODE=1

# ------------------------------------------------------------------- networks
# Only one shared network. Created with:
#   docker network create migration-net
LAB_NETWORK=migration-net

# ----------------------------------------------------- published ports (host)
# Only consoles and the proxy publish ports (a lab decision, not a requirement),
# and all published ports are bound to 127.0.0.1.
#
# 8080 and 3001 are deliberately NOT used: on this host they are already held by
# pre-existing containers (cadvisor on 8080, grafana on 3001) that are outside
# this project. TC-ST01-08 checks that no wildcard bind exists on these ports;
# reusing a port owned by another stack would make that check meaningless and
# would prevent the proxy from starting at all.
BIND_ADDR=127.0.0.1
MINIO_CONSOLE_PORT=9001
SILO_CONSOLE_PORT=9011
MINIO_PROXY_PORT=18080
SILO_PROXY_PORT=18081

# ------------------------------------------------------------------ containers
MINIO_IMAGE=minio-ce-local:RELEASE.2025-10-15T17-29-55Z
SILO_IMAGE=pgsty/silo:RELEASE.2026-09-16T00-00-00Z
MC_IMAGE=mc-local:RELEASE.2025-08-13T08-35-41Z
WARP_IMAGE=minio/warp:v1.3.1@sha256:72ae1b02216b51bd102b73a6923b597c092a5acc7a655c936c2f31bee897a7c5
PROXY_IMAGE=nginx:1.27-alpine

# ----------------------------------------------------------------- credentials
# Synthetic, lab-only values. Never real, company or personal data.
# Replace with your own; do not commit a filled-in .env.
MINIO_ROOT_USER=<ACCESS_KEY>
MINIO_ROOT_PASSWORD=<SECRET_KEY>

# DEV-909 replication target (lab/compose/replication-target). Separate
# credentials, so the target is never reachable with the baseline's root keys.
REPLICATION_TARGET_ROOT_USER=<ACCESS_KEY>
REPLICATION_TARGET_ROOT_PASSWORD=<SECRET_KEY>

# --------------------------------------------------------------- test dataset
# Profile B specifies 5-10 GB. Reduced to 2 GB so MinIO and Silo datasets both
# fit in the 21 GB free disk alongside the images and cluster volumes.
DATASET_SMALL_MB=256
DATASET_TOTAL_GB=2
WARP_OBJECT_SIZE=64MiB
WARP_OBJECT_COUNT=200
BENCH_REPEATS=3
# Monitoring project. Prometheus publishes no RELEASE.* tags,
# so it is pinned by immutable semver tag AND registry digest. See D-014.
PROMETHEUS_IMAGE=prom/prometheus:v3.15.0@sha256:efd719c99d83b060d9daefdcf00360461adf279f45ef5391f8d111892118753e

# warp also has no RELEASE.* tags; pinned by immutable semver tag + digest. D-014.
